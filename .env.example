# Copy to .env.local for local development, and add the same names in
# Vercel → Settings → Environment Variables. Never commit real values.

# "supabase" stores accounts, cases and files in your Supabase project.
# "local" (or unset) keeps the browser-only demo backend.
NEXT_PUBLIC_BACKEND=supabase

# Supabase → Connect (or Settings → API Keys). These two are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Server only. Needed for account deletion, photo comparison and the audit worker.
# Never give this a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Server only. Google AI Studio key for photo comparison, the move-out audit
# and the case assistant.
GEMINI_API_KEY=YOUR_GEMINI_KEY
# Optional. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=

# Server only. Claude API key from the Claude Console (platform.claude.com).
# Claude reads the letter and lease, reviews assistant answers, and stands in
# when Gemini is busy. Without it, Gemini does those jobs alone.
ANTHROPIC_API_KEY=sk-ant-YOUR_CLAUDE_KEY
# Optional. Defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=
