# Copy to .env.local for local development, and add the same names in
# Vercel → Settings → Environment Variables. Never commit real values.

# "supabase" stores accounts, cases and files in your Supabase project.
# "local" (or unset) keeps the browser-only demo backend.
NEXT_PUBLIC_BACKEND=supabase

# Supabase → Connect (or Settings → API Keys). These two are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Shows "Continue with Google" when NEXT_PUBLIC_BACKEND=supabase. Turn on only
# after enabling the Google provider in Supabase Auth and adding
# <your site>/** to its redirect URLs. Never shown in local mode.
NEXT_PUBLIC_ENABLE_OAUTH=false

# Server only. Needed for account deletion, photo comparison and the audit worker.
# Never give this a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Server only. Primary service credentials for photo comparison and case tools.
ANTHROPIC_API_KEY=YOUR_PRIMARY_SERVICE_KEY
# Optional service configuration override.
# ANTHROPIC_MODEL=
# Optional. Fast mode is on by default: quicker answers at about twice the
# price. Set to off for standard speed and price.
# ANTHROPIC_FAST_MODE=off

# Server only. Required by the live move-out audit worker and used as a backup by supported case tools.
GEMINI_API_KEY=YOUR_BACKUP_SERVICE_KEY
# Optional service configuration override.
# GEMINI_MODEL=

# Shows the connection check in the case assistant. It always shows in development.
NEXT_PUBLIC_SHOW_AI_STATUS=false
